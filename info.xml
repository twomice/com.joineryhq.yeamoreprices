<?xml version="1.0"?>
<extension key="com.joineryhq.yeamoreprices" type="module">
  <file>yeamoreprices</file>
  <name>YEA More Fixed Price Options</name>
  <description>Custom for YEA; increases to 15 the number of "Fixed Price Options" available in a Contribution Page.</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joineryhq.yeamoreprices</url>
    <url desc="Documentation">https://github.com/twomice/com.joineryhq.yeamoreprices</url>
    <url desc="Support">https://github.com/twomice/com.joineryhq.yeamoreprices/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2017-04-18</releaseDate>
  <version>0.2-beta1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Implements PHP and template overrides; see "Documentation" link above or README.md.</comments>
  <civix>
    <namespace>CRM/Yeamoreprices</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
